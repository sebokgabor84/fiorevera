#!/bin/sh
# Pre-commit.
# 1. FV-GUARD: refuses a commit on main. Vercel deploys production from every push to main, so
#    work is committed on a branch and reaches main only through a pull request the owner merges
#    (.agent/skills/release-manager/SKILL.md).
# 2. When component code, styles, the HTML shell or the visual specs are staged, runs the visual
#    regression suite against a fresh production build. A red run blocks the commit until the
#    diff was reviewed (npm run visual:review) and either the code is fixed or the owner approved
#    the new look (npm run test:visual:update -- --approved-by="<name>" --note="…").
# Emergency bypass for the owner, in his own terminal only: FV_SKIP_HOOKS=1 git commit …
if [ "$FV_SKIP_HOOKS" = "1" ]; then exit 0; fi

branch=$(git symbolic-ref --short -q HEAD || true)
case "$branch" in
  main | master)
    echo ""
    echo "pre-commit: REFUSED — you are on '$branch', and '$branch' is production."
    echo "    Nothing was committed. Move the work to a branch (staged changes travel with you):"
    echo "        git switch -c <feature|fix|chore|docs|content>/<short-desc>"
    echo "    then commit again. Rules: .agent/skills/release-manager/SKILL.md"
    exit 1
    ;;
esac

# FV-RULE (owner, 2026-11-18): a feature branch is rebased onto main, never merged with it.
merging=$(git rev-parse -q --verify MERGE_HEAD 2>/dev/null || true)
main_merge=0
for ref in origin/main main origin/master master; do
  tip=$(git rev-parse -q --verify "$ref" 2>/dev/null || true)
  [ -n "$merging" ] && [ "$merging" = "$tip" ] && main_merge=1
done
case "${GIT_REFLOG_ACTION:-}" in
  "merge origin/main" | "merge main" | "merge origin/master" | "merge master") main_merge=1 ;;
esac
if [ "$main_merge" = 1 ]; then
  echo ""
  echo "pre-commit: REFUSED — this merges main into '$branch'. Hard rule: rebase instead."
  echo "    git merge --abort"
  echo "    git fetch && git rebase origin/main"
  echo "    An already pushed branch is then pushed with: git push --force-with-lease origin $branch"
  echo "    Rules: .agent/skills/release-manager/SKILL.md §5"
  exit 1
fi

if git diff --cached --name-only | grep -Eq '^(src/|index\.html$|public/fonts/|tests/visual/)'; then
  echo "pre-commit: UI files staged → build + visual regression"
  npm run build >/dev/null 2>&1 || { echo "pre-commit: build failed"; exit 1; }
  if ! npm run test:visual >/dev/null 2>&1; then
    echo ""
    echo "pre-commit: visual regression FAILED. Review the differences first:"
    echo "    npm run visual:review        (expected / actual / diff per snapshot)"
    echo "Then either fix the code, or — with the owner's GO on the new look —"
    echo "    npm run test:visual:update -- --approved-by=\"<name>\" --note=\"<why>\""
    echo "and stage tests/visual/__screenshots__ + docs/qa/visual-baselines-log.md with this commit."
    exit 1
  fi
  echo "pre-commit: visual regression green"
fi
