{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "fiorevera-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "fiorevera-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview",
        "--",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173
    },
    {
      "name": "visual-review",
      "runtimeExecutable": "./node_modules/.bin/vite",
      "runtimeArgs": [
        "preview",
        "--outDir",
        "tests/visual",
        "--port",
        "4174",
        "--strictPort"
      ],
      "port": 4174
    }
  ]
}
